<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The self-test runs on the same runtime the engine ships on, so an
      interop mistake shows up here rather than on a user's machine.
    -->
    <TargetFramework>net40</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>dptengine-selftest</AssemblyName>
    <RootNamespace>DPT.Engine.SelfTest</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DPT.Engine\DPT.Engine.csproj" />
    <ProjectReference Include="..\DPT.Engine.Shared\DPT.Engine.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Core" />
  </ItemGroup>

</Project>
