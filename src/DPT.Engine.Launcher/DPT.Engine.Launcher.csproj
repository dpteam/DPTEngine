<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net40;net9.0-windows</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <AssemblyName>dptengine-launcher</AssemblyName>
    <RootNamespace>DPT.Engine.Launcher</RootNamespace>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>DPT.Engine Launcher</AssemblyTitle>
    <Product>DPT.Engine</Product>
    <Company>DartPower Team</Company>
    <Copyright>Copyright (C) DartPower Team. GPLv2.</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <ApplicationIcon>..\..\resources\dptengine.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!--
    The protocol is compiled in so the launcher is one exe: a launcher that needs
    a DLL beside it is a launcher that breaks when someone copies it out of the
    distribution folder.
  -->
  <ItemGroup>
    <Compile Include="..\DPT.Engine.Shared\MasterProtocol.cs" Link="Shared\MasterProtocol.cs" />
    <Compile Include="..\DPT.Engine.Shared\MasterSessionInfo.cs" Link="Shared\MasterSessionInfo.cs" />
    <Compile Include="..\DPT.Engine.Shared\MasterProjectInfo.cs" Link="Shared\MasterProjectInfo.cs" />
    <Compile Include="..\DPT.Engine.Shared\MasterClient.cs" Link="Shared\MasterClient.cs" />
    <Compile Include="..\DPT.Engine.Shared\Branding.cs" Link="Shared\Branding.cs" />
    <Compile Include="..\DPT.Engine.Shared\PortablePaths.cs" Link="Shared\PortablePaths.cs" />
    <Compile Include="..\DPT.Engine.Shared\Json.cs" Link="Shared\Json.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ui.html" LogicalName="DPT.Engine.Launcher.Assets.ui.html" />
    <EmbeddedResource Include="Assets\theme.css" LogicalName="DPT.Engine.Launcher.Assets.theme.css" />
    <EmbeddedResource Include="Assets\app.js" LogicalName="DPT.Engine.Launcher.Assets.app.js" />
  </ItemGroup>

  <!-- System.Core is implicit on modern targets and only needed for net40. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <Reference Include="System.Core" />
  </ItemGroup>

</Project>
