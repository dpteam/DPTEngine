<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net40 keeps the shared protocol usable by the XP-compatible runtime, the
      launcher, the editor host and the master. net9.0 is only there so the same
      code can be exercised by modern tooling and by a modern master build.
    -->
    <TargetFrameworks>net40;net9.0</TargetFrameworks>
    <RootNamespace>DPT.Engine.Shared</RootNamespace>
    <AssemblyName>DPT.Engine.Shared</AssemblyName>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>DPT.Engine shared protocol</AssemblyTitle>
    <Product>DPT.Engine</Product>
    <Company>DartPower Team</Company>
    <Copyright>Copyright (C) DartPower Team.</Copyright>
    <Version>1.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net40'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
